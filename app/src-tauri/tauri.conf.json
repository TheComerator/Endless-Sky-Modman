{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Endless Sky Mod Manager",
  "mainBinaryName": "esmm",
  "version": "0.1.1",
  "identifier": "io.github.thecomerator.esmm",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Endless Sky Mod Manager",
        "width": 1200,
        "height": 800,
        "minWidth": 960,
        "minHeight": 620
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true,
    "macOS": {
      "signingIdentity": "-"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDdGRTY3NEM0QTFCNDQ5OEUKUldTT1NiU2h4SFRtZnhjeDhaWnFMWjZuL2xlYW9RSS83SFRLZlVGREdlVjFZQmk5K251cEs3S3kK",
      "endpoints": [
        "https://github.com/TheComerator/Endless-Sky-Modman/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
